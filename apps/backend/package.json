{
  "name": "@subarashi/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "bun cfman wrangler --account=\"subarashi\" deploy",
    "deploy:w": "wrangler deploy",
    "dev": "bun cfman wrangler --account=\"subarashi\"  dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "dev:db": "bun cfman wrangler --account=\"subarashi\" d1 execute subarashi_db --local --file=./src/db/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.53.0"
  }
}
